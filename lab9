# задача 15 (найти количество чисел, встречающихся в массиве чётное кол-во раз)
import numpy as np
def find_nums(arr): # ф-ия принимает список arr и возвращает список list с элементами, встречающимися четное кол-во раз
    arr = np.array(arr) # преобразования списка в numpy-массив (для работы с операциями numpy)
    unique, counts = np.unique(arr, return_counts=True) # np.unique возвращает уникальные эл-ы массива и их кол-во (возвращаем только кол-во вхождений каждого эл-ма)
    res_nums = unique[counts % 2 == 0] # в массиве count выбираем чёт. эл-мы (если true) и берём из массива unique, соответствующие им значения (кол-ву)
    result = arr[np.isin(arr, res_nums)] # фильтрация исходного маcсива arr (оставляем только res_nums)
    return result.tolist() # numpy-массив преобразуется в список

# пример работы функции с разными массивами
if __name__ == "__main__":

    arr1 = [10, 20, 20, 30, 30, 30, 40, 40, 40, 40]
    print("Test 1:", find_nums(arr1))  # ожидаемый результат: [20, 20, 40, 40, 40, 40]

    arr2 = [1, 3, 3, 3, 5, 5, 5, 5, 5]
    print("Test 2:", find_nums(arr2))  # ожидаемый результат: []

    arr3 = [2, 2, 4, 4, 4, 4]
    print("Test 3:", find_nums(arr3))  # ожидаемый результат: [2, 2, 4, 4, 4, 4]

    arr4 = []
    print("Test 4:", find_nums(arr4))  # ожидаемый результат: []

    arr5 = [100]
    print("Test 5:", find_nums(arr5))  # ожидаемый результат: []

    arr6 = [6, 6, 6, 6, 6, 6]
    print("Test 6:", find_nums(arr6))  # Ожидаемый результат: [6, 6, 6, 6, 6, 6]
